# ============================================================
# CREDENTIAL TEMPLATE — copy this file to credential.env
# and fill in your actual values.
# credential.env is blocked by .gitignore and should NEVER
# be committed to the repository.
# ============================================================

# Supabase connection details
# Found in: Supabase dashboard → Project Settings → Database
SUPABASE_HOST=your-project-ref.supabase.co
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-database-password
SUPABASE_PORT=5432
